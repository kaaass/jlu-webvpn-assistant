{
  "name": "jlu-webvpn-assistant",
  "version": "1.1.5",
  "description": "A Tampermonkey script for better using JLU WebVPN",
  "author": "KAAAsS",
  "private": true,
  "main": "/src/main.js",
  "keywords": [
    "tampermonkey",
    "webpack",
    "vue",
    "element-ui",
    "axios"
  ],
  "scripts": {
    "dev": "node ./scripts/run-with-env.js .env.dev webpack-dev-server --open --config webpack.dev.js",
    "build": "node ./scripts/run-with-env.js .env webpack --config webpack.prod.js && node ./scripts/run-with-env.js .env node build.js",
    "test": "node ./scripts/run-with-env.js .env.test webpack --config webpack.test.js --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "clean-webpack-plugin": "^3.0.0",
    "css-loader": "^5.0.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^4.5.0",
    "sass": "^1.77.8",
    "sass-loader": "^12.6.0",
    "style-loader": "^2.0.0",
    "vue-loader": "^15.9.5",
    "vue-template-compiler": "^2.6.12",
    "webpack": "^5.71.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.7.4",
    "webpack-merge": "^5.4.0"
  },
  "dependencies": {
    "aes-js": "^3.1.2",
    "axios": "^0.21.0",
    "element-ui": "^2.14.1",
    "lodash": "^4.17.21",
    "url-parse": "^1.5.4",
    "vue": "^2.6.12"
  }
}
